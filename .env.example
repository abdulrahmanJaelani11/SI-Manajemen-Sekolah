# ==============================================================================
# ENVIRONMENT CONFIGURATION - SISTEM MANAJEMEN SEKOLAH
# ==============================================================================

# Database Connection (PostgreSQL Lokal / Supabase)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
# Contoh lokal: postgresql://postgres:postgres@localhost:5432/db_manajemen_sekolah?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/db_manajemen_sekolah?schema=public"

# Autentikasi & Keamanan JWT
JWT_SECRET="rahasia_jwt_sekolah_super_aman_2026_change_in_production"
JWT_EXPIRES_IN="7d"

# Konfigurasi File Storage
# Pilihan driver: "local" (default development) atau "supabase" (production)
STORAGE_DRIVER="local"

# Konfigurasi Supabase Storage (Diperlukan jika STORAGE_DRIVER="supabase")
SUPABASE_URL="https://[PROJECT-ID].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."
SUPABASE_STORAGE_BUCKET="sekolah_uploads"

# Application URL
APP_URL="http://localhost:3000"
